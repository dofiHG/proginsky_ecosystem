# MODX supports Friendly URLs via this .htaccess file.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Перенаправление всех поддоменов progin.tech на новый домен proginsky.ru
  RewriteCond %{HTTP_HOST} ^(.+)\.progin\.tech$ [NC]
  RewriteRule ^ https://proginsky.ru%{REQUEST_URI} [R=301,L]

  # Перенаправление основного домена progin.tech на proginsky.ru
  RewriteCond %{HTTP_HOST} ^(www\.)?progin\.tech$ [NC]
  RewriteRule ^ https://proginsky.ru%{REQUEST_URI} [R=301,L]

  # Перенаправление поддомена mailbox на поддиректорию
  RewriteCond %{HTTP_HOST} ^mailbox\.proginsky\.ru$ [NC]
  RewriteCond %{REQUEST_URI} !^/mailbox/
  RewriteRule ^(.*)$ /mailbox/$1 [L]

  # Перенаправление с proginsky.ru/mailbox на поддомен mailbox
  RewriteCond %{HTTP_HOST} ^(www\.)?proginsky\.ru$ [NC]
  RewriteRule ^mailbox(/.*)?$ https://mailbox.proginsky.ru$1 [R=301,L]

  # Перенаправление index.php на корневой URL
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php(/)?\ HTTP/
  RewriteRule ^index\.php(/)?$ https://proginsky.ru [R=301,L]

  # Предотвращение неправильного обращения с запросами, содержащими двойной слеш (//)
  RewriteCond %{THE_REQUEST} //
  RewriteRule ^.*$ $0 [R=301,L]

  # Исключение директории .well-known из переписывания для LetsEncrypt
  RewriteRule "^\.well-known/" - [L]

  # Защита от доступа к скрытым директориям (например, .git, .svn), кроме .well-known
  RewriteRule "/\.|^\.(?!well-known/)" - [F]

  # Принудительное использование HTTPS и удаление www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Friendly URLs MODX
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php?q=$1 [L,QSA]
  
  # Перенаправление всех несуществующих поддоменов на страницу 404
  # Проверка, что поддомен присутствует в запросе, но не является существующим поддоменом
  RewriteCond %{HTTP_HOST} ^([a-z0-9-]+)\.proginsky\.ru$ [NC]
  RewriteCond %{HTTP_HOST} !^(www|mailbox|blog|shop)\.proginsky\.ru$ [NC] # добавьте все существующие поддомены
  RewriteRule ^ https://proginsky.ru/404 [R=404,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Включение сжатия для оптимизации загрузки страниц
php_flag zlib.output_compression On
php_value zlib.output_compression_level 5

# Кэширование статических файлов
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Дополнительные заголовки для безопасности и кэширования
# ВАЖНО! ВСЕ новые сервисы нужно добавлять в CSP в исключения
<IfModule mod_headers.c>
  <FilesMatch "\.(jpeg|jpg|gif|png|webp|svg|ico|js|css|ttf|eot|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always append X-Frame-Options SAMEORIGIN
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://progin.tech https://cdn.jsdelivr.net https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://plausible.io https://mc.yandex.ru https://app.moyklass.com https://api-maps.yandex.ru; style-src 'self' 'unsafe-inline' https://progin.tech https://cdn.jsdelivr.net https://app.moyklass.com https://fonts.googleapis.com; img-src 'self' data: https://progin.tech https://www.google.com https://app.moyklass.com; font-src 'self' data: https://progin.tech https://cdn.jsdelivr.net https://app.moyklass.com https://fonts.gstatic.com; media-src 'self' https://progin.tech; manifest-src 'self' https://progin.tech; frame-src 'self' https://www.google.com https://mc.yandex.ru; frame-ancestors 'self' https://www.google.com; connect-src 'self' https://plausible.io https://www.googletagmanager.com https://www.google-analytics.com https://mc.yandex.ru https://app.moyklass.com;"
</IfModule>


# Пользовательские страницы ошибок
ErrorDocument 404 /404
ErrorDocument 500 /500
